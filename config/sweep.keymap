// #include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500// 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20// 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "behaviors/character_map.dtsi"
#include "behaviors/report.dtsi"


#define MAC 0
#define DVO 1
#define GRA 2
#define RIG 3
#define LEF 4
#define TRI 5
#define MOUSE 6

/* No trackpad or encoder hardware on this build.
#define SPEED_POINTER 0
#define SPEED_SCROLL 1
#define SPEED_PREV 0
#define SPEED_NEXT 1
#define SPEED_RESET 2
#define SPEED_FINE_PREV 3
#define SPEED_FINE_NEXT 4
#define CIRQUE_MODE_RELATIVE 0
#define CIRQUE_MODE_ABSOLUTE 1
#define CIRQUE_MODE_TOGGLE 2

&sensors {
	left_encoder {
		triggers-per-rotation = <15>;
	};
	right_encoder {
		triggers-per-rotation = <45>;
	};
};

&glidepoint_listener {
	input-processors = <&pointer_processor 0 0 &drag_scroll_processor 1 8>;
};
*/

/ {
	/* No trackpad hardware on this build.
	pointer_processor: pointer_processor {
		compatible = "zmk,input-processor-pointer-speed";
		#input-processor-cells = <2>;
		track-remainders;
		pointer-curve = "adaptive";
		pointer-curve-deadzone = <2>;
		pointer-curve-accel-multiplier = <1>;
		pointer-curve-accel-divisor = <12>;
		pointer-curve-max-delta = <120>;
		one-x-multiplier = <1>;
		one-x-divisor = <1>;
		min-percent = <10>;
		max-percent = <400>;
		initial-speed-position = <50>;
	};

	drag_scroll_processor: drag_scroll_processor {
		compatible = "zmk,input-processor-drag-scroll";
		#input-processor-cells = <2>;
		track-remainders;
		native-wheel-axis = "horizontal-when-enabled";
		scroll-min-step = <1>;
		one-x-multiplier = <1>;
		one-x-divisor = <1>;
		min-percent = <10>;
		max-percent = <1000>;
		initial-speed-position = <50>;
	};
	*/

	behaviors {
		/* No trackpad hardware on this build.
		drgscrl: drag_scroll {
			compatible = "zmk,behavior-drag-scroll";
			#binding-cells = <0>;
		};

		ptr_spd: pointing_speed {
			compatible = "zmk,behavior-pointing-speed";
			#binding-cells = <2>;
		};

		enc_ptr_spd: encoder_pointer_speed {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&ptr_spd SPEED_POINTER SPEED_PREV>, <&ptr_spd SPEED_POINTER SPEED_NEXT>;
		};

		enc_scrl_spd: encoder_scroll_speed {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&ptr_spd SPEED_SCROLL SPEED_PREV>, <&ptr_spd SPEED_SCROLL SPEED_NEXT>;
		};

		crq_mode: crqm {
			compatible = "zmk,behavior-cirque-mode";
			#binding-cells = <1>;
		};
		*/

		/* Not in use for now.
		sel_x: select_x {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <125>;
			bindings = <&mkp>, <&kp>;
		};
		*/
		
		/* No trackpad hardware on this build.
		ds_z: drag_scroll_z {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <125>;
			bindings = <&drgscrl>, <&kp>;
		};
		*/

		ht: hold_tap {
			label = "hold_tap";
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <125>;
			global-quick-tap;
			bindings = <&kp>, <&kp>;
		};
		mmv {
			acceleration-exponent = <1>;// 1
			time-to-max-speed-ms = <300>;// 40
			delay-ms = <0>;// 0
		};
		msc {
			acceleration-exponent = <0>;// 0
			time-to-max-speed-ms = <40>;// 500
			delay-ms = <0>;// 10
		};
	};
	
	conditional_layers {
		compatible = "zmk,conditional-layers";
		
		tri_layer {
			if-layers = <RIG LEF>;
			then-layer = <TRI>;
		};
	};

	/* Combos not in use for now.
	combos {
		compatible = "zmk,combos";

		combo_er_right_click {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <2 3>;
			layers = <MAC DVO MOUSE>;
			bindings = <&mkp RCLK>;
		};

		combo_rt_forward {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <3 4>;
			layers = <MAC DVO MOUSE>;
			bindings = <&mkp MB5>;
		};

		combo_df_left_click {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <12 13>;
			layers = <MAC DVO MOUSE>;
			bindings = <&mkp LCLK>;
		};

		combo_fg_back {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <13 14>;
			layers = <MAC DVO MOUSE>;
			bindings = <&mkp MB4>;
		};

		combo_cv_middle_click {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <22 23>;
			layers = <MAC DVO MOUSE>;
			bindings = <&mkp MCLK>;
		};
	};
	*/
	
	keymap {
		compatible = "zmk,keymap";
		
		default_layer {
			display-name = "DEF";
			bindings = <
			&kp Q  &kp W       &kp E        &kp R       &kp T      &kp Y  &kp U       &kp I        &kp O       &kp P
			&kp A  &ht LALT S  &ht LGUI D  &ht LCTRL F  &kp G      &kp H  &ht RCTRL J  &ht RGUI K  &ht RALT L  &kp SEMI
			&kp Z  &kp X       &kp C        &kp V       &kp B      &kp N  &kp M       &kp COMMA    &kp DOT     &kp ENTER
			&trans  &lt LEF TAB  &mt LSHIFT SPACE      &kp BSPC  &lt RIG TAB  &trans
			>;
			/* No encoder hardware on this build.
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
			*/
		};
		
		dvorak_layer {
			display-name = "DVO";
			bindings = <
			&kp SEMI  &kp COMMA   &kp DOT     &kp P        &kp Y      &kp F  &kp G        &kp C       &kp R       &kp L
			&kp A     &ht LALT O  &ht LGUI E  &ht LCTRL U  &kp I      &kp D  &ht RCTRL H  &ht RGUI T  &ht RALT N  &kp S
			&kp SQT   &kp Q       &kp J       &kp K        &kp X      &kp B  &kp M        &kp W       &kp V       &kp ENTER
			&trans  &lt LEF TAB  &mt LSHIFT SPACE      &kp BSPC  &lt RIG TAB  &trans
			>;
			/* No encoder hardware on this build.
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
			*/
		};

		gra_layer {
			display-name = "GRA";
			bindings = <
			&kp B  &kp L       &kp D        &kp W       &kp Z      &kp SQT  &kp F       &kp O        &kp U       &kp J
			&kp N  &ht LALT R  &ht LCTRL T  &ht LGUI S  &kp G      &kp Y    &ht RGUI H  &ht RCTRL A  &ht RALT E  &kp I
			&kp Q  &kp X       &kp M        &kp C       &kp V      &kp K    &kp P       &kp DOT      &kp MINUS   &kp ENTER
			&trans  &lt LEF TAB  &mt LSHIFT SPACE      &kp BSPC  &lt RIG TAB  &trans
			>;
			/* No encoder hardware on this build.
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
			*/
		};

		right_layer {
			display-name = "NUM";
			bindings = <
			&kp N1   &kp N2    &kp N3     &kp N4   &kp N5      &kp N6    &kp N7     &kp N8     &kp N9     &kp N0
			&kp DEL  &kp CAPS  &kp PSCRN  &kp INS  &trans      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
			&trans   &trans    &trans     &trans   &trans      &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
			&trans      &trans  &kp ESC      &trans  &trans  &trans
			>;
			/* No encoder hardware on this build.
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
			*/
		};
		
		left_layer {
			display-name = "SYM";
			bindings = <
			&kp EXCL  &kp AMPS  &kp HASH   &kp DLLR   &kp EQUAL            &kp PLUS   &kp AT     &kp ASTRK  &kp GRAVE  &kp TILDE
			&kp SEMI  &kp LBKT  &kp LBRC   &kp LPAR   &default_report      &kp FSLH   &kp RPAR   &kp RBRC   &kp RBKT   &kp MINUS
			&kp SQT   &kp DQT   &kp PRCNT  &kp COLON  &trans               &kp BSLH   &kp UNDER  &kp CARET  &kp PIPE   &kp QMARK
			&trans  &trans  &trans      &tog MOUSE  &trans  &trans
			>;
			/* No encoder hardware on this build.
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
			*/
		};
		
		tri_layer {
			display-name = "FUN";
			bindings = <
			&kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0      &bt BT_SEL 2  &out OUT_TOG   &tog DVO        &kp C_MUTE    &kp C_PREV
			&kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1      &bt BT_SEL 3  &kp C_BRI_UP   &studio_unlock  &kp C_VOL_UP  &kp C_PP
			&kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR        &bt BT_SEL 4  &kp C_BRI_DEC  &tog GRA        &kp C_VOL_DN  &kp C_NEXT
			&trans      &trans  &trans      &trans  &trans  &trans
			>;
			/* No encoder hardware on this build.
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
			*/
		};
	
		mouse {
			display-name = "MOUSE";
			bindings = <
			&tog MOUSE  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans         &trans  &trans          &msc SCRL_UP    &trans           &tog MOUSE
			&trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MCLK      &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans
			&trans      &trans          &trans          &trans           &trans         &trans  &trans          &trans          &trans           &trans
			&trans  &kp SPACE  &mkp LCLK      &mkp RCLK  &kp LSHIFT  &trans
			>;
			/* No trackpad hardware on this build.
			sensor-bindings = <&enc_ptr_spd &enc_scrl_spd>;
			*/
		};
	};
};
